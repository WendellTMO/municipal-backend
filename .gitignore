# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtualenv
.venv/
venv/
env/

# Env files
.env
.env.*
# Keep the checked-in template: ".env.*" above would otherwise swallow it.
!.env.example
.python-version

# =========================
# Pytest / Coverage
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# =========================
# Logs
# =========================
*.log

# =========================
# OS / Editor
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/

# =========================
# Build / dist
# =========================
build/
dist/
*.egg-info/
.eggs/

# =========================
# SQLite local (se usar)
# =========================
*.sqlite
*.db


# Firebase credentials
firebase-credentials.json

# =========================
# OpenAPI
# =========================
# Generated by swagger2openapi
docs/openapi3.json

# =========================
# Terraform / infrastructure
# =========================
# infra/terraform/.gitignore already covers that directory. These rules repeat
# the protection at the repo root so a terraform run in any other directory is
# covered too.

# Local provider plugins and modules (large binaries, re-created by "terraform init")
.terraform/

# State files: describe live infrastructure and can contain secrets in plain text
*.tfstate
*.tfstate.*

# Variable files: routinely hold credentials. The committed template is kept.
*.tfvars
*.tfvars.json
!*.tfvars.example

# OpenStack credentials file
clouds.yaml

# Terraform crash logs
crash.log
crash.*.log

# =========================
# Load testing (loadtest/README.md)
# =========================
loadtest/results/*
!loadtest/results/.gitkeep
loadtest/exports/*
!loadtest/exports/.gitkeep

# Segredos e backups: os repositórios são públicos
*.keystore
!debug.keystore
*.jks
*.p12
*.pfx
*.pem
*.dump
*.pass
*.tfstate
*.tfstate.backup
*.tfvars
clouds.yaml
buska-backups/

# Respostas do formulário e relatórios da importação de convites (dados pessoais de alunos)
*respostas*.csv
*-relatorio-*.csv
